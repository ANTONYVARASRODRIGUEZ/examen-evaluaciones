<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Editar Evaluación</title>
</head>
<body class="container mt-5">
    <div class="card p-4 shadow">
        <h3>Editar Evaluación</h3>
        <form action="/update" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="id_evaluacion" value="<%= eval.id_evaluacion %>">
            <input type="hidden" name="old_archivo" value="<%= eval.archivo %>">
            
            <div class="mb-3">
                <label>Título</label>
                <input type="text" name="titulo" class="form-control" value="<%= eval.titulo %>" required>
            </div>
            <div class="mb-3">
                <label>Curso</label>
                <select name="id_curso" class="form-select">
    <% cursos.forEach(curso => { %>
        <option value="<%= curso.id_curso %>" <%= eval.id_curso == curso.id_curso ? 'selected' : '' %> >
            <%= curso.nombre_curso %>
        </option>
    <% }) %>
</select>
            </div>
            <div class="mb-3">
                <p>Imagen actual: <%= eval.archivo %></p>
                <label>Cambiar imagen (opcional)</label>
                <input type="file" name="archivo" class="form-control">
            </div>
            <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
            <a href="/" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</body>
</html>